{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iproy.com.ar/fhir/nucleo/modulo.schema.json",
  "title": "Manifiesto de módulo del núcleo iProy",
  "type": "object",
  "required": ["id", "nombre", "version", "licencia", "nucleo", "permisos"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$", "description": "Identificador único; también es el prefijo de sus tablas" },
    "nombre": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "licencia": { "type": "string", "description": "Identificador SPDX. Un módulo que se carga dentro del núcleo debe ser AGPL-3.0-or-later" },
    "autor": { "type": "string" },
    "nucleo": { "type": "string", "description": "Versiones del núcleo compatibles, p. ej. >=1.0 <2.0" },
    "perfiles": { "type": "array", "items": { "type": "string" }, "description": "Perfiles PIM que usa (pim-pma, pim-orden…)" },
    "permisos": { "type": "array", "items": { "type": "string", "pattern": "^system/[A-Za-z*]+\\.[cruds]+$" }, "description": "Alcances SMART que pide" },
    "eventos": { "type": "array", "items": { "type": "string" }, "description": "Eventos del bus a los que se suscribe" },
    "pantallas": { "type": "array", "items": { "type": "object", "required": ["ruta", "titulo"], "properties": { "ruta": { "type": "string" }, "titulo": { "type": "string" } } } },
    "tablas": { "type": "array", "items": { "type": "string" }, "description": "Tablas propias; deben empezar con el id del módulo" }
  }
}
