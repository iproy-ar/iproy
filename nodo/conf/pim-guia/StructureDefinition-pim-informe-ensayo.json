{
  "resourceType": "StructureDefinition",
  "id": "pim-informe-ensayo",
  "url": "https://iproy.com.ar/fhir/StructureDefinition/pim-informe-ensayo",
  "name": "PimInformeEnsayo",
  "title": "PIM — Informe de ensayo o verificación técnica",
  "status": "draft",
  "description": "Ensayo reglamentario o verificación técnica de un PMA o de una instalación, con acta firmada (Ley 25.506).",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "DiagnosticReport",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/DiagnosticReport",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "DiagnosticReport",
        "path": "DiagnosticReport",
        "constraint": [
          {
            "key": "pim-sin-paciente",
            "severity": "error",
            "human": "Ningún recurso PIM se refiere a un paciente.",
            "expression": "descendants().ofType(Reference).where(reference.startsWith('Patient/')).empty()",
            "source": "https://iproy.com.ar/fhir/StructureDefinition/pim-informe-ensayo"
          }
        ]
      },
      {
        "id": "DiagnosticReport.status",
        "path": "DiagnosticReport.status",
        "mustSupport": true
      },
      {
        "id": "DiagnosticReport.code",
        "path": "DiagnosticReport.code",
        "binding": {
          "strength": "extensible",
          "valueSet": "https://iproy.com.ar/fhir/ValueSet/pim-ensayo"
        }
      },
      {
        "id": "DiagnosticReport.subject",
        "path": "DiagnosticReport.subject",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://hl7.org/fhir/StructureDefinition/Device",
              "http://hl7.org/fhir/StructureDefinition/Location"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "DiagnosticReport.effective[x]",
        "path": "DiagnosticReport.effective[x]",
        "min": 1,
        "type": [
          {
            "code": "dateTime"
          }
        ],
        "mustSupport": true
      },
      {
        "id": "DiagnosticReport.performer",
        "path": "DiagnosticReport.performer",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "DiagnosticReport.conclusion",
        "path": "DiagnosticReport.conclusion",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "DiagnosticReport.conclusionCode",
        "path": "DiagnosticReport.conclusionCode",
        "binding": {
          "strength": "required",
          "valueSet": "https://iproy.com.ar/fhir/ValueSet/pim-conformidad"
        }
      },
      {
        "id": "DiagnosticReport.presentedForm",
        "path": "DiagnosticReport.presentedForm",
        "min": 1,
        "mustSupport": true
      }
    ]
  }
}
