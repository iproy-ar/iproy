        "constraint": [
          {
            "key": "pim-sin-paciente",
            "severity": "error",
            "human": "Ningún recurso PIM se refiere a un paciente.",
            "expression": "descendants().ofType(Reference).where(reference.startsWith('Patient/')).empty()",
            "source": "https://iproy.com.ar/fhir/StructureDefinition/pim-solicitud"
          }
        ]
      },
