  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "DeviceMetric",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/DeviceMetric",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "DeviceMetric.identifier",
        "path": "DeviceMetric.identifier",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "DeviceMetric.type",
        "path": "DeviceMetric.type",
        "binding": {
          "strength": "extensible",
          "valueSet": "https://iproy.com.ar/fhir/ValueSet/pim-punto-medicion"
        }
      },
      {
        "id": "DeviceMetric.unit",
        "path": "DeviceMetric.unit",
        "mustSupport": true
      },
      {
        "id": "DeviceMetric.source",
        "path": "DeviceMetric.source",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://iproy.com.ar/fhir/StructureDefinition/pim-activo",
              "https://iproy.com.ar/fhir/StructureDefinition/pim-sistema",
              "https://iproy.com.ar/fhir/StructureDefinition/pim-pma"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "DeviceMetric.parent",
        "path": "DeviceMetric.parent",
        "mustSupport": true
      },
      {
        "id": "DeviceMetric.category",
        "path": "DeviceMetric.category",
        "mustSupport": true
      },
      {
        "id": "DeviceMetric.calibration",
        "path": "DeviceMetric.calibration",
        "mustSupport": true
      }
    ]
  }
