{
  "resourceType": "StructureDefinition",
  "id": "pim-procedencia",
  "url": "https://iproy.com.ar/fhir/StructureDefinition/pim-procedencia",
  "name": "PimProcedencia",
  "title": "PIM — Procedencia con huella encadenada",
  "status": "draft",
  "description": "Una procedencia por versión de recurso. signature.data lleva el SHA-256 de la versión encadenado al de la versión anterior: cualquier alteración del historial rompe la cadena.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Provenance",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Provenance",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Provenance.target",
        "path": "Provenance.target",
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Provenance.recorded",
        "path": "Provenance.recorded",
        "mustSupport": true
      },
      {
        "id": "Provenance.activity",
        "path": "Provenance.activity",
        "mustSupport": true
      },
      {
        "id": "Provenance.agent",
        "path": "Provenance.agent",
        "mustSupport": true
      },
      {
        "id": "Provenance.signature",
        "path": "Provenance.signature",
        "min": 1,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Provenance.signature.sigFormat",
        "path": "Provenance.signature.sigFormat",
        "patternCode": "application/x-pim-huella"
      },
      {
        "id": "Provenance.signature.data",
        "path": "Provenance.signature.data",
        "min": 1,
        "mustSupport": true
      }
    ]
  }
}
