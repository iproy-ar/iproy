{
  "resourceType": "StructureDefinition",
  "id": "pim-pma",
  "url": "https://iproy.com.ar/fhir/StructureDefinition/pim-pma",
  "name": "PimPma",
  "title": "PIM — Producto médico activo",
  "status": "draft",
  "description": "Producto médico activo en uso. Lleva los cinco datos mínimos del REFES (Res. SGS 532/2026) como MustSupport: la exigencia legal depende de la tipología y la verifica la operación Device/$refes (invariante de advertencia pim-pma-refes). Un PMA conectado se identifica además por su EUI-64 (IHE MEM-DMC).",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Device",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Device",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Device",
        "path": "Device",
        "constraint": [
          {
            "key": "pim-pma-refes",
            "severity": "warning",
            "human": "Faltan datos mínimos del REFES (n.º PM ANMAT, pertenencia y fecha de fabricación o de puesta en marcha). Son obligatorios para las tipologías de la Res. SGS 532/2026; la operación Device/$refes informa cuáles faltan.",
            "expression": "identifier.where(system = 'https://iproy.com.ar/fhir/sid/anmat-pm').exists() and extension('https://iproy.com.ar/fhir/StructureDefinition/pim-pertenencia').exists() and (manufactureDate.exists() or extension('https://iproy.com.ar/fhir/StructureDefinition/pim-puesta-en-marcha').exists())",
            "source": "https://iproy.com.ar/fhir/StructureDefinition/pim-pma"
          },
          {
            "key": "pim-sin-paciente",
            "severity": "error",
            "human": "Ningún recurso PIM se refiere a un paciente.",
            "expression": "descendants().ofType(Reference).where(reference.startsWith('Patient/')).empty()",
            "source": "https://iproy.com.ar/fhir/StructureDefinition/pim-pma"
          }
        ]
      },
      {
        "id": "Device.extension",
        "path": "Device.extension",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "url"
            }
          ],
          "ordered": false,
          "rules": "open"
        },
        "min": 1
      },
      {
        "id": "Device.extension:categoriaAlcance",
        "path": "Device.extension",
        "sliceName": "categoriaAlcance",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://iproy.com.ar/fhir/StructureDefinition/pim-categoria-alcance"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Device.extension:categoriaAlcance.value[x]",
        "path": "Device.extension.value[x]",
        "patternCoding": {
          "code": "A",
          "system": "https://iproy.com.ar/fhir/CodeSystem/pim-categoria-alcance"
        }
      },
      {
        "id": "Device.extension:puestaEnMarcha",
        "path": "Device.extension",
        "sliceName": "puestaEnMarcha",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://iproy.com.ar/fhir/StructureDefinition/pim-puesta-en-marcha"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Device.extension:pertenencia",
        "path": "Device.extension",
        "sliceName": "pertenencia",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://iproy.com.ar/fhir/StructureDefinition/pim-pertenencia"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Device.extension:claseRiesgoPM",
        "path": "Device.extension",
        "sliceName": "claseRiesgoPM",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://iproy.com.ar/fhir/StructureDefinition/pim-clase-riesgo-pm"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Device.extension:iru",
        "path": "Device.extension",
        "sliceName": "iru",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://iproy.com.ar/fhir/StructureDefinition/pim-iru"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Device.identifier",
        "path": "Device.identifier",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "system"
            }
          ],
          "rules": "open"
        },
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Device.identifier:inventario",
        "path": "Device.identifier",
        "sliceName": "inventario",
        "min": 1,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Device.identifier:inventario.system",
        "path": "Device.identifier.system",
        "min": 1,
        "fixedUri": "https://iproy.com.ar/fhir/sid/activo"
      },
      {
        "id": "Device.identifier:inventario.value",
        "path": "Device.identifier.value",
        "min": 1
      },
      {
        "id": "Device.identifier:anmatPM",
        "path": "Device.identifier",
        "sliceName": "anmatPM",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Device.identifier:anmatPM.system",
        "path": "Device.identifier.system",
        "min": 1,
        "fixedUri": "https://iproy.com.ar/fhir/sid/anmat-pm"
      },
      {
        "id": "Device.identifier:anmatPM.value",
        "path": "Device.identifier.value",
        "min": 1,
        "constraint": [
          {
            "key": "pim-anmat-pm",
            "severity": "error",
            "human": "El n.º de producto ANMAT tiene el formato PM-N-N, con uno a cinco dígitos por grupo (p. ej. PM-1137-45) [a confirmar con el padrón ANMAT].",
            "expression": "matches('^PM-[0-9]{1,5}-[0-9]{1,5}$')",
            "source": "https://iproy.com.ar/fhir/StructureDefinition/pim-pma"
          }
        ]
      },
      {
        "id": "Device.identifier:eui64",
        "path": "Device.identifier",
        "sliceName": "eui64",
        "short": "EUI-64 del equipo (MSH-3 / OBX-18 de IHE PCD-15)",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Device.identifier:eui64.system",
        "path": "Device.identifier.system",
        "min": 1,
        "fixedUri": "https://iproy.com.ar/fhir/sid/eui64"
      },
      {
        "id": "Device.identifier:eui64.value",
        "path": "Device.identifier.value",
        "min": 1
      },
      {
        "id": "Device.status",
        "path": "Device.status",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Device.manufacturer",
        "path": "Device.manufacturer",
        "mustSupport": true
      },
      {
        "id": "Device.manufactureDate",
        "path": "Device.manufactureDate",
        "mustSupport": true
      },
      {
        "id": "Device.serialNumber",
        "path": "Device.serialNumber",
        "mustSupport": true
      },
      {
        "id": "Device.modelNumber",
        "path": "Device.modelNumber",
        "mustSupport": true
      },
      {
        "id": "Device.owner",
        "path": "Device.owner",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://iproy.com.ar/fhir/StructureDefinition/pim-organismo"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Device.location",
        "path": "Device.location",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://iproy.com.ar/fhir/StructureDefinition/pim-local"
            ]
          }
        ],
        "mustSupport": true
      }
    ]
  }
}
